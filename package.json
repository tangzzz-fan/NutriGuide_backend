{
  "name": "nutriguide-backend",
  "version": "1.0.0",
  "description": "NutriGuide Backend API - MVP Phase",
  "author": "NutriGuide Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:qa": "NODE_ENV=qa nest start",
    "start:prod": "NODE_ENV=production node dist/main",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:cov": "NODE_ENV=test jest --coverage",
    "test:debug": "NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json",
    "db:seed": "NODE_ENV=development ts-node -r tsconfig-paths/register scripts/seed-database.ts",
    "db:seed:clear": "NODE_ENV=development ts-node -r tsconfig-paths/register scripts/seed-database.ts --clear",
    "db:seed:qa": "NODE_ENV=qa ts-node -r tsconfig-paths/register scripts/seed-database.ts",
    "db:restore": "NODE_ENV=development ./scripts/restore-database.sh",
    "db:restore:qa": "NODE_ENV=qa ./scripts/restore-database.sh",
    "db:restore:prod": "NODE_ENV=production ./scripts/restore-database.sh --confirm-production",
    "db:restore:env": "./scripts/restore-env-data.sh",
    "db:restore:docker": "./scripts/restore-docker-data.sh",
    "db:normalize": "./scripts/normalize-collection-names.sh",
    "api:docs": "chmod +x scripts/export-api-docs.sh && ./scripts/export-api-docs.sh",
    "api:docs:quick": "chmod +x scripts/export-api-docs.sh && ./scripts/export-api-docs.sh --quick",
    "api:check": "chmod +x scripts/export-api-docs.sh && ./scripts/export-api-docs.sh --check",
    "docker:seed": "docker-compose -f docker-compose.dev.yml --profile seeding up nutriguide-seeder-dev",
    "docker:seed:clear": "docker-compose -f docker-compose.dev.yml --profile seeding run --rm nutriguide-seeder-dev npm run db:seed:clear",
    "docker:build": "docker build -t nutriguide-backend .",
    "docker:build:dev": "docker build -t nutriguide-backend:dev --build-arg NODE_ENV=development .",
    "docker:build:qa": "docker build -t nutriguide-backend:qa --build-arg NODE_ENV=qa .",
    "docker:build:prod": "docker build -t nutriguide-backend:prod --build-arg NODE_ENV=production .",
    "docker:up:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:up:qa": "docker-compose -f docker-compose.qa.yml up",
    "docker:up:prod": "docker-compose -f docker-compose.prod.yml up",
    "docker:down": "docker-compose down"
  },
  "keywords": [],
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "mongoose": "^7.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.22",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}